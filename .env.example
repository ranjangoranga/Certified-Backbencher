# Copy to .env; NEVER commit real keys. APP_ORIGIN must match your HTTPS website.
APP_ORIGIN=http://localhost:3000
PORT=3000
NODE_ENV=development
STORAGE_DIR=./storage
PYTHON=python3
# Set the real Instagram profile URL before offering trials.
INSTAGRAM_URL=
# Payment credentials from your verified Razorpay merchant account. Google Pay is a UPI choice in checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
